# Copy to .env.local for local development. Set the same names in Vercel
# (Project → Settings → Environment Variables) for Production and Preview.
# Full walkthrough: SETUP.md. Live status of each: /admin/integrations.

# ── Database: MongoDB Atlas ────────────────────────────────────────────────
# Atlas → Database → Connect → Drivers → copy the URI, paste your password in.
# Leave blank locally and the site runs from .data/cms.json instead.
MONGODB_URI=
MONGODB_DB=fabulla

# ── Admin panel ────────────────────────────────────────────────────────────
# 32+ random characters. Signs the login cookie. Changing it signs everyone out.
#   openssl rand -base64 32
ADMIN_SESSION_SECRET=
# First owner account. Used once: the first login with exactly these creates
# the owner in the database. After that manage people on /admin/team.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Media: Cloudflare R2 ───────────────────────────────────────────────────
# Cloudflare dashboard → R2. Create a bucket, enable public access (custom
# domain or r2.dev), then Manage R2 API Tokens → Create (Object Read & Write).
# Add a CORS rule on the bucket allowing PUT from your site's origin.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fabulla-media
# e.g. https://media.fabulladiamonds.com or https://pub-xxxx.r2.dev
R2_PUBLIC_URL=

# ── Email: Resend ──────────────────────────────────────────────────────────
# resend.com → API Keys. EMAIL_FROM must be on a domain verified in Resend;
# "onboarding@resend.dev" works for testing but only delivers to your own inbox.
RESEND_API_KEY=
EMAIL_FROM="Fabulla Diamonds <hello@fabulladiamonds.com>"

# ── AI: Google Gemini ──────────────────────────────────────────────────────
# aistudio.google.com → Get API key. Powers the chatbot and the "generate a
# variant" button on product photos. Without it the chatbot answers from FAQs.
GEMINI_API_KEY=
# Optional overrides if Google renames models; /admin/integrations lists what
# the key can see.
# GEMINI_CHAT_MODEL=gemini-3.8-flash
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
