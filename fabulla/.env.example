# Copy to .env.local and fill in. .env.local is gitignored; never commit a key.

# The concierge chat widget. Without this the endpoint still answers, from the
# studio's own facts in src/lib/concierge.ts, and labels those replies "Studio
# answer" instead of "AI concierge". Set it and Claude answers instead.
# Key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
